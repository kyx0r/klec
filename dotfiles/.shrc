#
# ~/.shrc
#
# nextsh-only settings. Sourced explicitly from ~/.lrc, after ~/.rc has run.
# nextsh is /bin/sh here, but dash/bash can be invoked as sh too, so guard:
# $NEXTSH_VERSION is unique to nextsh and readonly, set at startup (sh.c).
# argv[0] checks are useless, nextsh behaves the same under every name.
# unset HISTFILE: it is exported below, foreign shells must not inherit ~/.shist
case "$NEXTSH_VERSION" in nextsh*) ;; *) unset HISTFILE; return ;; esac

# --- history ---------------------------------------------------------------
# nextsh has no default HISTFILE: unset means no persistence at all.
# Keep it apart from ~/.bhist, bash writes HISTTIMEFORMAT "#epoch" lines there.
export HISTFILE="$HOME"/.shist
# The ring is preallocated (histsize+1 pointers), so ~/.rc's 67108864 costs
# ~512MB of address space per shell. 100k lines is ~800KB and plenty.
export HISTSIZE=100000
export HISTCONTROL=ignoredups:ignorespace
# nextsh flushes each command to HISTFILE immediately and shares it live between
# concurrent shells, so no PROMPT_COMMAND/histappend equivalent is needed.

# --- line editing ----------------------------------------------------------
# vi mode is already implied by EDITOR=vi, set it explicitly anyway.
set -o vi
# ^L clear, ^R redraw and / search are built into vi mode (edit.c).
# NB: the `bind` builtin only touches the emacs keymap, it is inert under vi.

stty -ixon 2>/dev/null	# free ^S/^Q for the editor

# `r` is ksh's redo (alias r='fc -s'), but ~/.rc redefines r() as recursive
# grep, so reach for these instead.
alias h='fc -l'		# list history
alias redo='fc -s'	# redo: `redo`, `redo cc`, `redo old=new cc`

# `cat >` not mv: mv swaps the inode, live shells keep the deleted one
hdedup() {
	dedup "$HISTFILE" > "${HISTFILE}_" && cat "${HISTFILE}_" > "$HISTFILE"
	rm -f "${HISTFILE}_"
}
